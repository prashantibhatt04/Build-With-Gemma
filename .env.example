# Which Gemma backend to use: "ollama" (local) or "api" (hosted Gemini-style endpoint)
GEMMA_BACKEND=ollama

# Model name/tag. For Ollama this is the local model tag (e.g. gemma4:e4b).
# For the hosted API this is the model id used in the generateContent URL.
GEMMA_MODEL=gemma4:e4b

# Base URL of a local Ollama server. Only used when GEMMA_BACKEND=ollama.
OLLAMA_HOST=http://localhost:11434

# API key for the hosted Gemini-style generateContent endpoint.
# Only used when GEMMA_BACKEND=api. Leave empty for the local backend.
GEMMA_API_KEY=

# Hosted model id - separate from GEMMA_MODEL because Ollama tags (e.g.
# gemma4:e4b) and hosted API model ids use different naming schemes and
# are not interchangeable. Check which Gemma models your key actually has
# access to (GET https://generativelanguage.googleapis.com/v1beta/models).
GEMMA_MODEL_API=gemma-4-26b-a4b-it

# Directory where decision audit logs (JSON lines, one file per day) are written.
LOG_DIR=./logs

# Starting simplified delta-v budget (m/s) for CRITICAL avoidance maneuvers.
# Not a real fuel/mass model - just a bound so repeated CRITICAL events
# can't silently execute an unlimited number of maneuvers.
DELTA_V_BUDGET_M_S=5.0

# Ollama embedding model used ONLY for "ask about the mission log" search
# (src/rag.py) - always via Ollama regardless of GEMMA_BACKEND, since the
# hosted API has no embedding endpoint wired up here. Requires a reachable
# local Ollama with this model pulled (ollama pull nomic-embed-text).
GEMMA_EMBED_MODEL=nomic-embed-text

# Webhook URL for real-time CRITICAL-event alerts (see src/alerting.py).
# Slack Incoming Webhook compatible ({"text": ...} payload) - also works
# with Discord, Microsoft Teams (via a compatible payload), or any custom
# HTTP receiver. Leave empty to disable alerting entirely (the default).
ALERT_WEBHOOK_URL=

# Space-Track.org credentials (see ROADMAP_TO_PRODUCT.md Phase 1) - register
# a free account at https://www.space-track.org/auth/createAccount. Used by
# SpaceTrackAdapter (src/ingestion/spacetrack_adapter.py) for real
# conjunction-data-message-grade screening; CelesTrak (no credentials
# required) remains the default data source either way. Leave both empty
# to skip Space-Track entirely.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# Postgres connection string (see ROADMAP_TO_PRODUCT.md Phase 4), e.g.
# postgresql://user:pass@localhost:5432/build_with_gemma - switches
# DecisionLogger's storage backend from its default append-only JSONL
# files to a real database, for continuous/scheduled operation. Leave
# empty to keep using JSONL files (the default, no setup required).
DATABASE_URL=

# Real operator authentication for the dashboard (see src/auth.py) -
# "name:token,name2:token2". Leave empty to keep the dashboard's
# "Operator name" field as free text (the original, no-setup default) -
# configuring this closes the "anyone can type any name and approve a
# real maneuver as them" gap for production/shared use.
OPERATOR_TOKENS=

# Only used by `docker compose up` (see docker-compose.yml) - NOT read by
# this project's own Python code directly (that reads DATABASE_URL above,
# which docker-compose.yml builds FROM these three at container start,
# pointed at the `postgres` service rather than localhost). POSTGRES_DB/
# POSTGRES_USER default sensibly if left unset; POSTGRES_PASSWORD does
# NOT - `docker compose up` refuses to start without a real value here
# rather than silently using a well-known default password.
POSTGRES_DB=build_with_gemma
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
